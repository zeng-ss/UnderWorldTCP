# 行尾：交给 Git 按内容自动判断，避免跨平台协作时来回翻转
* text=auto

# Unity 的 .meta / .asset / .prefab 由引擎生成，强制 LF，防止 Unity 反复重写导致脏工作区
*.meta text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.physicsMaterial2D text eol=lf
*.assetbundle text eol=lf

# 明确声明二进制，禁止任何形式的转换或 diff
*.dll binary
*.pdb binary
*.exe binary
*.so binary
*.dylib binary
*.zip binary
*.rar binary
*.7z binary
*.bundle binary
*.bytes binary

# 美术与音频资源
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.tif binary
*.gif binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aiff binary
*.ttf binary
*.otf binary

# Protobuf 生成物：机器产出，合并冲突时不要试图三方合并
Server/Network/Proto/*.cs linguist-generated=true -diff

